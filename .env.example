# ==============================================================================
# ChatGPT for DevOps Terminal Assistant - Environment Configuration
# ==============================================================================
# IMPORTANT: Copy this file to '.env' and add your API key.
# Never commit your real '.env' file containing API keys to Git!
# ==============================================================================

# 1. Primary LLM API Key (Can be Google Gemini or OpenAI or Groq)
LLM_API_KEY=

# 2. Or Specific Provider Keys:
# Google Gemini API Key (Recommended - Free Tier Available at https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=

# Groq API Key (https://console.groq.com/ - Ultra-fast inference)
GROQ_API_KEY=

# 3. Optional Model Override
# Defaults:
# - Gemini: gemini-1.5-flash
# - OpenAI: gpt-4o-mini
# - Groq: llama-3.3-70b-versatile
LLM_MODEL=

# 4. Optional Custom OpenAI-Compatible Base URL (For Ollama, DeepSeek, Local, etc.)
# Examples:
# - Ollama: http://localhost:11434/v1
# - DeepSeek: https://api.deepseek.com/v1
# - OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=
